set shell := ["bash", "-euo", "pipefail", "-c"]

# Set up the project's Python environment.
setup:
    uv sync --frozen

# Syntax-check the Python tools.
check:
    uv run python -c 'from pathlib import Path; [compile(p.read_bytes(), str(p), "exec") for p in Path("scripts").glob("*.py")]'

# Build the native mod with the root Nix shell's Switch toolchain.
build:
    uv run python scripts/build_mod.py

# Install the built mod into local Eden.
install:
    uv run python ../scripts/install_mod.py --source dist --name "Party Hidden Moves v1.3.0"
    uv run python scripts/debug_mount.py init

# List models or update the live debug configuration without rebuilding.
debug *args:
    uv run python scripts/debug_mount.py {{args}}

# Exercise the native lifecycle with a mocked engine boundary.
test:
    uv run python scripts/build_mod.py --test-only
